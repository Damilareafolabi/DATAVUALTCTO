# CMRG DataCore OS
# Production Environment Variables Example

# ==========================================
# 1. Server Configuration
# ==========================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://datacore.cmrg.org

# ==========================================
# 2. Database Configuration
# ==========================================
# MUST be internal VPC IP in production. Never expose publicly.
DATABASE_URL="postgresql://user:password@localhost:5432/cmrg_data"

# ==========================================
# 3. Security Secrets
# ==========================================
# JWT Signing Secret (MUST BE 256-BIT SECURE RANDOM STRING)
JWT_SECRET="generate_secure_random_string_here"

# Session Expiry Configurations
SESSION_EXPIRY="12h"
ACCESS_CODE_EXPIRY="15m"

# ==========================================
# 4. Storage & Media Processing
# ==========================================
STORAGE_BUCKET_NAME="cmrg-private-media-vault"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
MALWARE_SCANNER_ENDPOINT="http://internal-scanner:8080/scan"
