rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getOrgId() {
      return request.auth.token.organizationId;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function isSuperAdmin() {
      return getUserRole() == 'super_admin';
    }
    
    function isSystemAdmin() {
      return getUserRole() in ['super_admin', 'system_admin'];
    }
    
    function isProjectManager() {
      return getUserRole() in ['super_admin', 'system_admin', 'project_manager'];
    }
    
    function isEnumerator() {
      return getUserRole() in ['super_admin', 'system_admin', 'project_manager', 'enumerator'];
    }
    
    function isReadOnly() {
      return getUserRole() in ['super_admin', 'system_admin', 'project_manager', 'enumerator', 'read_only'];
    }
    
    function belongsToOrg(resourceOrgId) {
      return isAuthenticated() && getOrgId() == resourceOrgId;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Organizations - only super admins can manage
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && belongsToOrg(resource.data.ownerId);
      allow write: if isAuthenticated() && isSuperAdmin() && belongsToOrg(resource.data.ownerId);
    }

    // Users - org-scoped with role-based access
    match /users/{userId} {
      allow read: if isAuthenticated() && belongsToOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && isSystemAdmin() && belongsToOrg(get(request.resource).data.organizationId);
      allow update: if isAuthenticated() && isSystemAdmin() && belongsToOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && isSuperAdmin() && belongsToOrg(resource.data.organizationId);
    }

    // Projects - org-scoped with role-based access
    match /projects/{projectId} {
      allow read: if isAuthenticated() && belongsToOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && isProjectManager() && belongsToOrg(get(request.resource).data.organizationId);
      allow update: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
    }

    // Forms - org-scoped with role-based access
    match /forms/{formId} {
      allow read: if isAuthenticated() && belongsToOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && isProjectManager() && belongsToOrg(get(request.resource).data.organizationId);
      allow update: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
    }

    // Form Versions - org-scoped
    match /form_versions/{versionId} {
      allow read: if isAuthenticated() && belongsToOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && isProjectManager() && belongsToOrg(get(request.resource).data.organizationId);
      allow update: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
    }

    // Submissions - enumerators can only write their own, others can read in their org
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && belongsToOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && isEnumerator() && belongsToOrg(get(request.resource).data.organizationId);
      allow update: if isAuthenticated() && isEnumerator() && resource.data.userId == request.auth.uid && belongsToOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
    }

    // Assignments - project managers manage, enumerators can read their own
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (belongsToOrg(resource.data.organizationId) || resource.data.enumeratorId == request.auth.uid);
      allow create: if isAuthenticated() && isProjectManager() && belongsToOrg(get(request.resource).data.organizationId);
      allow update: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
    }

    // Exports - generated by project managers+
    match /exports/{exportId} {
      allow read: if isAuthenticated() && belongsToOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && isProjectManager() && belongsToOrg(get(request.resource).data.organizationId);
      allow update: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && isProjectManager() && belongsToOrg(resource.data.organizationId);
    }

    // Invitations - temporary tokens for user signup
    match /invitations/{inviteId} {
      allow read: if isAuthenticated() && belongsToOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && isSystemAdmin() && belongsToOrg(get(request.resource).data.organizationId);
      allow update: if isAuthenticated() && isSystemAdmin() && belongsToOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && isSystemAdmin() && belongsToOrg(resource.data.organizationId);
    }
  }
}
